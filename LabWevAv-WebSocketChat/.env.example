# Puerto del servidor
PORT=3000

# Dominio permitido para conexiones WebSocket (validacion de Origin)
ALLOWED_ORIGIN=http://localhost:3000

# Secreto para firmar JWT propios del servidor
JWT_SECRET=tu_secreto_aqui

# Firebase Admin SDK - Copiar valores desde el JSON de Service Account descargado
FIREBASE_PROJECT_ID=tu_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@tu_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_PRIVATE_KEY_AQUI\n-----END PRIVATE KEY-----\n"
