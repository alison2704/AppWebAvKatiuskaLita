<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proyecto       : webapppolimusicv1_asp
  Aplicacion IIS : Default Web Site/webapppolimusicv1_asp
  Carpeta fisica : C:\inetpub\wwwroot\webapppolimusicv1_asp
  Ruta base      : /webapppolimusicv1_asp/

  Configuracion de IIS para la aplicacion ASP Clasico.
  Se mantiene deliberadamente minima para evitar secciones bloqueadas.
  Los limites de subida y ASP se configuran en deploy.ps1 (nivel servidor).
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="default.asp" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
